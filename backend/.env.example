PORT=4000
# Postgres connection string. Get one free at https://neon.tech (or any other Postgres host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# The origin of the deployed Next.js app (e.g. https://fleetpilot.vercel.app).
CORS_ORIGIN=http://localhost:3000
