// FleetPilot Postgres schema.
// Generated by the deployment migration — replaces the in-memory store at src/db/store.js.
//
// Conventions:
//   - IDs are cuid() strings (keeps the existing hex-id shape in API responses).
//   - createdAt / updatedAt are real DateTime so we can orderBy at the DB layer.
//   - Domain dates that come from <input type="date"> stay as String to preserve the
//     "YYYY-MM-DD" wire format the frontend already speaks. Same for shift / location
//     timestamps, which were ISO-string-compared in the old store.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   // "admin" | "driver"
  passwordHash String
  avatarColor  String   @default("bg-foreground")
  phone        String   @default("")

  driver           Driver?
  authoredMessages Message[]  @relation("AuthoredMessages")
  alerts           Alert[]    @relation("UserAlerts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  email           String
  phone           String   @default("")
  avatarColor     String   @default("bg-amber-500")
  city            String   @default("")
  licenseClass    String   @default("")
  licenseExpiry   String   @default("")
  experienceYears Int      @default(0)
  approved        Boolean  @default(false)

  assignedEventId String?
  assignedEvent   Event?   @relation("DriverAssignedEvent", fields: [assignedEventId], references: [id], onDelete: SetNull)

  shiftStartedAt  String?
  shiftEndedAt    String?

  rating          Float    @default(0)
  shiftsCompleted Int      @default(0)
  hoursThisWeek   Float    @default(0)

  // Flattened location object (lat: 0, lng: 0 ⇒ "no real location yet").
  locationLat       Float    @default(0)
  locationLng       Float    @default(0)
  locationUpdatedAt String?

  // Signup documents (data URLs). Stripped from list responses by withoutDocs().
  qidImage     String? @db.Text
  licenseImage String? @db.Text

  invitations Invitation[]
  shifts      Shift[]
  cars        Car[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id          String  @id @default(cuid())
  name        String
  model       String  @default("")
  plateNumber String  @unique

  assignedDriverId String?
  assignedDriver   Driver? @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)

  // Plain strings so they round-trip with <input type="date"> in the UI.
  assignmentStart String?
  assignmentEnd   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedDriverId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  startDate   String
  endDate     String
  location    String
  status      String   @default("upcoming") // upcoming | ongoing | completed
  driverLimit Int?

  invitations    Invitation[]
  shifts         Shift[]
  messages       Message[]
  assignedDrivers Driver[] @relation("DriverAssignedEvent")
  alerts         Alert[]   @relation("EventAlerts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id          String  @id @default(cuid())
  eventId     String
  driverId    String
  status      String  // invited | accepted | declined | closed
  invitedAt   String
  respondedAt String?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, driverId])
  @@index([driverId])
}

model Shift {
  id        String  @id @default(cuid())
  driverId  String
  eventId   String
  startedAt String
  endedAt   String?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([eventId])
}

model Alert {
  id            String  @id @default(cuid())
  title         String
  message       String
  type          String  @default("info") // emergency | shift | system | info
  read          Boolean @default(false)
  recipientType String  // all-drivers | event-drivers | user | admin

  recipientUserId  String?
  recipientUser    User?   @relation("UserAlerts", fields: [recipientUserId], references: [id], onDelete: Cascade)

  recipientEventId String?
  recipientEvent   Event?  @relation("EventAlerts", fields: [recipientEventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientUserId])
  @@index([recipientEventId])
}

model Message {
  id           String  @id @default(cuid())
  eventId      String
  authorUserId String
  authorName   String
  authorRole   String
  body         String  @db.Text

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation("AuthoredMessages", fields: [authorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}
